---
// Implements docs §11.2 — orientation + the commitments strip, folded into one section.
import { valueProposition } from "../content/copy";

const commitments = valueProposition.commitments;
---

<section id="valor" class="section value-prop">
  <div class="container value-prop__inner">
    <p class="value-prop__text">{valueProposition.text}</p>
    <ul class="value-prop__chips">
      {commitments.map((c) => (
        <li class="chip">
          <span class={`chip__swatch chip__swatch--${c.swatch === "ochre" ? "ochre" : "accent"}`}></span>
          {c.label}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .value-prop {
    background: var(--color-surface);
  }

  .value-prop__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .value-prop__text {
    max-width: 48ch;
    font-size: 1.05rem;
  }

  .value-prop__chips {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 700px) {
    .value-prop__chips {
      grid-template-columns: repeat(4, auto);
    }
  }
</style>
