---
// src/components/Contact.astro
import { businessConfig } from "../config/business";
import { telHref, isWhatsappConfigured, whatsappHref } from "../utils/whatsapp";
import { quoteWizard } from "../content/copy";
import Icon from "./Icon.astro";
import QuoteWizard from "./QuoteWizard.astro";

const { phone, email, businessHours, neighborhoods, address } = businessConfig;
const phoneLink = telHref();
const whatsappReady = isWhatsappConfigured();
const directWhatsappLink = whatsappHref("Olá, Reginaldo! Gostaria de tirar uma dúvida sobre pintura.");
---

<section id="contato" class="section contact">
  <div class="container">
    <!-- Section Header & Quick Contact Badges -->
    <div class="contact__header">
      <h2>{quoteWizard.heading}</h2>
      <p class="contact__intro">{quoteWizard.intro}</p>

      <div class="contact__badges">
        {phoneLink && (
          <a class="contact__badge" href={phoneLink} aria-label={`Ligar para ${phone}`}>
            <Icon name="phone" size={18} />
            <span>Ligar agora: <strong>{phone}</strong></span>
          </a>
        )}

        <a class="contact__badge contact__badge--whatsapp" href={directWhatsappLink} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size={18} />
          <span>{whatsappReady ? "WhatsApp direto" : "WhatsApp (em breve)"}</span>
        </a>

        {businessHours && businessHours.length > 0 && (
          <div class="contact__badge contact__badge--plain">
            <Icon name="clipboard" size={18} />
            <span>Seg a Sex: 8h às 18h</span>
          </div>
        )}
      </div>
    </div>

    <!-- Central Interactive Stepper Wizard -->
    <div class="contact__wizard-wrap">
      <QuoteWizard />
    </div>

    <!-- Bottom Context & Service Areas -->
    <div class="contact__meta">
      {neighborhoods && neighborhoods.length > 0 && (
        <p class="contact__areas">
          <strong>Regiões atendidas:</strong> {neighborhoods.join(", ")}
        </p>
      )}

      {address.showPublicly && (address.street || address.city) && (
        <p class="contact__address">
          {[address.street, address.number, address.neighborhood, address.city, address.state]
            .filter(Boolean)
            .join(", ")}
        </p>
      )}

      {email && (
        <p class="contact__email">
          Prefere e-mail? <a href={`mailto:${email}`}>{email}</a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-canvas);
  }

  .contact__header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .contact__header h2 {
    font-size: var(--size-h2);
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .contact__intro {
    font-size: var(--size-body);
    color: var(--color-muted);
    margin-inline: auto;
    margin-bottom: var(--space-4);
  }

  .contact__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .contact__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: var(--size-small);
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .contact__badge:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .contact__badge--whatsapp {
    background: #f1f7f0;
    border-color: #c7dec5;
    color: #264a23;
  }

  .contact__badge--whatsapp:hover {
    border-color: var(--color-accent);
  }

  .contact__badge--plain {
    background: rgba(42, 36, 32, 0.04);
    border-color: transparent;
    color: var(--color-muted);
  }

  .contact__badge--plain:hover {
    transform: none;
    border-color: transparent;
  }

  .contact__wizard-wrap {
    margin-bottom: var(--space-5);
  }

  .contact__meta {
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: var(--size-small);
    color: var(--color-muted);
  }

  .contact__meta p {
    margin: 0;
  }

  .contact__email a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .contact__email a:hover {
    color: var(--color-accent-hover);
  }
</style>
