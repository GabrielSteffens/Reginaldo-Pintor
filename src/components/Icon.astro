---
/**
 * Shared single-weight line-icon set (§10). Icons are functional, not
 * decorative — always paired with a text label by the caller, never
 * carrying meaning alone.
 */
import type { IconName } from "../types/icons";
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
