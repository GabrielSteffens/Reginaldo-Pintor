---
/**
 * Shared single-weight line-icon set (§10). Icons are functional, not
 * decorative — always paired with a text label by the caller, never
 * carrying meaning alone.
 */
interface Props {
  name:
    | "roller"
    | "brush"
    | "drop"
    | "wallCorner"
    | "tape"
    | "check"
    | "phone"
    | "clipboard"
    | "whatsapp"
    | "chevronDown"
    | "arrows";
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

{
  name === "roller" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3" y="4" width="12" height="6" rx="1.5" />
      <line x1="9" y1="10" x2="9" y2="14" />
      <line x1="9" y1="14" x2="18" y2="14" />
      <line x1="18" y1="14" x2="18" y2="20" />
    </svg>
  )
}
{
  name === "brush" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M14 4 20 10 11 19H5v-6z" />
      <path d="M14 4 17 2" />
    </svg>
  )
}
{
  name === "drop" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 3c4 5 6 8 6 11a6 6 0 1 1-12 0c0-3 2-6 6-11Z" />
    </svg>
  )
}
{
  name === "wallCorner" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M4 20V4h16" />
      <path d="M4 12h8v8" />
    </svg>
  )
}
{
  name === "tape" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <ellipse cx="12" cy="8" rx="8" ry="4" />
      <path d="M4 8v3c0 2 3.5 4 8 4s8-2 8-4V8" />
    </svg>
  )
}
{
  name === "check" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M4 12.5 9.5 18 20 6" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M6 3h3l1.5 4.5L8 9.5a12 12 0 0 0 6.5 6.5l2-2.5L21 15v3a2 2 0 0 1-2 2C11.5 20 4 12.5 4 5a2 2 0 0 1 2-2Z" />
    </svg>
  )
}
{
  name === "clipboard" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="5" y="4" width="14" height="17" rx="1.5" />
      <path d="M9 4V3h6v1" />
      <line x1="8" y1="10" x2="16" y2="10" />
      <line x1="8" y1="14" x2="16" y2="14" />
    </svg>
  )
}
{
  name === "whatsapp" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.1-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm5.2 14.2c-.22.62-1.27 1.18-1.76 1.24-.45.06-1 .09-1.62-.1a13.9 13.9 0 0 1-1.75-.64c-3.08-1.34-5.08-4.44-5.24-4.65-.15-.21-1.26-1.67-1.26-3.19 0-1.52.8-2.27 1.08-2.58.28-.3.6-.38.8-.38h.58c.19 0 .43-.03.67.51.24.55.83 1.9.9 2.04.07.14.12.31.02.5-.1.19-.15.31-.3.48-.15.17-.31.38-.44.51-.15.15-.3.3-.13.6.17.3.75 1.24 1.6 2 .11.1.23.2.35.3.3.24.6.45.9.6.3.15.45.13.62-.08.17-.22.71-.83.9-1.11.18-.28.36-.24.6-.15.24.1 1.53.72 1.79.85.27.13.44.2.5.31.07.11.07.65-.15 1.27Z" />
    </svg>
  )
}
{
  name === "chevronDown" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  )
}
{
  name === "arrows" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M8 8 4 12l4 4" />
      <path d="M16 8l4 4-4 4" />
    </svg>
  )
}
