---
import { businessConfig } from "../config/business";
import { nav } from "../content/copy";
import CtaButton from "./CtaButton.astro";

const navLinks = nav.links;
const { logo } = businessConfig;
---

<header class="header">
  <div class="container header__bar">
    <a href={nav.brandHref} class="header__brand" class:list={[{ "header__brand--logo": logo.src }]}>
      {logo.src ? (
        <img src={logo.src} alt={logo.alt} class="header__logo" width="220" height="65" />
      ) : (
        businessConfig.businessName
      )}
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <CtaButton variant="primary" label={nav.ctaLabel} whatsappMessage="Olá! Gostaria de solicitar um orçamento." class="header__cta" />
      <button class="header__menu-toggle" type="button" aria-expanded="false" aria-controls="header-mobile-menu">
        <span class="visually-hidden">Abrir menu</span>
        <span class="header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="header-mobile-menu" class="header__mobile-menu" aria-label="Navegação móvel" hidden>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <CtaButton variant="primary" label={nav.ctaLabel} whatsappMessage="Olá! Gostaria de solicitar um orçamento." />
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".header__menu-toggle");
  const menu = document.querySelector<HTMLElement>("#header-mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    if (menu) menu.hidden = isOpen;
  });

  // Close the mobile menu after choosing a link.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      if (menu) menu.hidden = true;
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-line);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .header__brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* The logo's wordmark renders in white/gold, designed for a dark ground —
     it disappears on the light --color-canvas header, so give it its own
     dark chip (matches the footer's inverted palette) instead of sitting
     directly on the header background. */
  .header__brand--logo {
    display: inline-flex;
    align-items: center;
    background: var(--color-ink);
    border-radius: var(--radius-control);
    padding: 0.5em 0.9em;
  }

  .header__logo {
    display: block;
    height: 32px;
    width: auto;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav a {
    text-decoration: none;
    font-size: var(--size-small);
    color: var(--color-ink);
  }

  .header__nav a:hover {
    color: var(--color-accent);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__cta {
    display: none;
  }

  .header__menu-toggle {
    background: none;
    border: none;
    padding: 0.5em;
    cursor: pointer;
    display: inline-flex;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-ink);
    position: relative;
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before {
    top: -6px;
  }

  .header__menu-icon::after {
    top: 6px;
  }

  .header__mobile-menu {
    border-top: 1px solid var(--color-line);
    padding: var(--space-3) var(--space-2) var(--space-4);
  }

  .header__mobile-menu ul {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .header__mobile-menu a {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 1.05rem;
  }

  @media (min-width: 900px) {
    .header__logo {
      height: 38px;
    }

    .header__nav {
      display: block;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__menu-toggle {
      display: none;
    }
  }
</style>
