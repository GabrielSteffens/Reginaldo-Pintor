---
// Implements docs §11.8 / §20 — reads exclusively from businessConfig.
// Displays confirmed service cities and embeds the custom Google My Maps region.
import { businessConfig } from "../config/business";
import { whatsappHref } from "../utils/whatsapp";
import { serviceAreas } from "../content/copy";

const { neighborhoods, googleMapsEmbedUrl, googleMapsViewUrl } = businessConfig;

const mapEmbedSrc =
  googleMapsEmbedUrl ??
  "https://www.google.com/maps/d/embed?mid=1ml9efDRtBo4SUpt3yO_uiM26FPqJPcM";
const mapViewHref =
  googleMapsViewUrl ??
  "https://www.google.com/maps/d/viewer?mid=1ml9efDRtBo4SUpt3yO_uiM26FPqJPcM&usp=sharing";
const whatsappConsultUrl = whatsappHref(
  "Olá, Reginaldo! Gostaria de confirmar atendimento para pintura residencial na minha região."
);
---

<section id="atendimento" class="section section--surface service-areas">
  <div class="container">
    <!-- Section Intro -->
    <div class="service-areas__header">
      <span class="chip service-areas__badge">
        <span class="chip__swatch chip__swatch--accent"></span>
        <span>{serviceAreas.badge}</span>
      </span>
      <h2>{serviceAreas.heading}</h2>
      <p class="service-areas__intro">{serviceAreas.intro}</p>
    </div>

    {neighborhoods.length > 0 ? (
      <div class="service-areas__content">
        <!-- Confirmed Service Cities Badges -->
        <div class="service-areas__tags" aria-label="Cidades atendidas">
          {neighborhoods.map((city) => (
            <span class="city-badge">
              <svg class="city-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{city}</span>
            </span>
          ))}
        </div>

        <!-- Google My Maps Display Card -->
        <div id="service-map-panel" class="service-map-card" role="region" aria-label="Mapa de cobertura regional">
          <div class="service-map-card__frame">
            <iframe
              id="service-map-frame"
              src={mapEmbedSrc}
              title="Mapa de cobertura em São José, Florianópolis, Palhoça e Biguaçu - SC"
              width="100%"
              height="480"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Features / Quality Pillars -->
        <div class="service-areas__features">
          {serviceAreas.features.map((feat) => (
            <div class="feature-card">
              <div class="feature-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="feature-card__title">{feat.title}</h4>
                <p class="feature-card__text">{feat.text}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Direct CTA Bar -->
        <div class="service-areas__cta-box">
          <div class="service-areas__cta-text">
            <strong>Precisa de pintura em São José, Florianópolis, Palhoça ou Biguaçu?</strong>
            <span>Agende uma visita técnica ou tire dúvidas diretamente no WhatsApp.</span>
          </div>
          <div class="service-areas__cta-actions">
            <a href="#contato" class="btn btn--primary">
              Solicitar orçamento
            </a>
            <a href={whatsappConsultUrl} class="btn btn--secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Consultar no WhatsApp</span>
            </a>
            <a
              id="service-map-link"
              href={mapViewHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--secondary"
              title="Abrir mapa ampliado no Google Maps"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>{serviceAreas.openInMaps}</span>
            </a>
          </div>
        </div>
      </div>
    ) : (
      <p class="service-areas__empty">{serviceAreas.emptyMessage}</p>
    )}
  </div>
</section>

<style>
  .service-areas {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .service-areas__header {
    text-align: center;
    max-width: var(--content-max);
    margin: 0 auto var(--space-4);
  }

  .service-areas__badge {
    margin-bottom: var(--space-2);
    display: inline-flex;
  }

  .service-areas__header h2 {
    font-size: var(--size-h2);
    color: var(--color-ink);
    margin: 0 0 var(--space-2);
  }

  .service-areas__intro {
    font-size: var(--size-body);
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .service-areas__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Confirmed Service Cities Badges */
  .service-areas__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    justify-content: center;
    margin-bottom: var(--space-1);
  }

  .city-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.1rem;
    font-size: var(--size-small);
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-ink);
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-warm-soft);
    letter-spacing: -0.01em;
  }

  .city-badge__icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Map Card Container */
  .service-map-card {
    background-color: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    overflow: hidden;
    box-shadow: var(--shadow-warm);
  }

  /* Responsive Map Frame */
  .service-map-card__frame {
    position: relative;
    width: 100%;
    background-color: #ede9e0;
    line-height: 0;
  }

  .service-map-card__frame iframe {
    width: 100%;
    height: 480px;
    display: block;
  }

  /* Feature cards */
  .service-areas__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  @media (min-width: 680px) {
    .service-areas__features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: var(--space-2) var(--space-3);
    box-shadow: var(--shadow-warm-soft);
  }

  .feature-card__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgba(62, 79, 60, 0.08);
    color: var(--color-accent);
  }

  .feature-card__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
  }

  .feature-card__text {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* CTA Bar */
  .service-areas__cta-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--shadow-warm-soft);
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .service-areas__cta-box {
      flex-direction: row;
    }
  }

  .service-areas__cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .service-areas__cta-text {
      text-align: left;
    }
  }

  .service-areas__cta-text strong {
    font-size: 1rem;
    color: var(--color-ink);
  }

  .service-areas__cta-text span {
    font-size: var(--size-small);
    color: var(--color-muted);
  }

  .service-areas__cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .service-areas__empty {
    text-align: center;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .service-map-card__frame iframe {
      height: 360px;
    }

    .service-areas__cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .service-areas__cta-actions .btn {
      width: 100%;
    }
  }
</style>
