---
// Implements docs §11.8 / §20 — reads exclusively from businessConfig.
// Displays the 4 confirmed cities in Greater Florianópolis with an interactive Google Maps region viewer.
import { businessConfig } from "../config/business";
import { whatsappHref } from "../utils/whatsapp";
import { serviceAreas } from "../content/copy";

const { neighborhoods } = businessConfig;

interface CityRegion {
  id: string;
  name: string;
  query: string;
  zoom: number;
}

const regions: CityRegion[] = [
  {
    id: "sao-jose",
    name: "São José",
    query: "São José - SC",
    zoom: 13,
  },
  {
    id: "florianopolis",
    name: "Florianópolis",
    query: "Florianópolis - SC",
    zoom: 12,
  },
  {
    id: "palhoca",
    name: "Palhoça",
    query: "Palhoça - SC",
    zoom: 13,
  },
  {
    id: "biguacu",
    name: "Biguaçu",
    query: "Biguaçu - SC",
    zoom: 13,
  },
  {
    id: "todas",
    name: "Todas as Regiões",
    query: "Grande Florianópolis, São José - SC",
    zoom: 11,
  },
];

const defaultRegion = regions[0];
const initialMapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(defaultRegion.query)}&t=&z=${defaultRegion.zoom}&ie=UTF8&iwloc=&output=embed`;
const initialMapDirectUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(defaultRegion.query)}`;
const whatsappConsultUrl = whatsappHref("Olá, Reginaldo! Gostaria de confirmar atendimento para pintura residencial na minha região.");
---

<section id="atendimento" class="section section--surface service-areas">
  <div class="container">
    <!-- Section Intro -->
    <div class="service-areas__header">
      <span class="chip service-areas__badge">
        <span class="chip__swatch chip__swatch--accent"></span>
        <span>{serviceAreas.badge}</span>
      </span>
      <h2>{serviceAreas.heading}</h2>
      <p class="service-areas__intro">{serviceAreas.intro}</p>
    </div>

    {neighborhoods.length > 0 ? (
      <div class="service-areas__content">
        <!-- Interactive City Switcher Tabs -->
        <div class="service-areas__tabs" role="tablist" aria-label="Selecione a cidade para ver no mapa">
          {regions.map((reg, index) => (
            <button
              type="button"
              class={`city-tab ${index === 0 ? "is-active" : ""}`}
              data-map-city={reg.id}
              data-query={reg.query}
              data-zoom={reg.zoom}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls="service-map-panel"
            >
              <svg class="city-tab__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="city-tab__name">{reg.name}</span>
            </button>
          ))}
        </div>

        <!-- Google Maps Display Card -->
        <div id="service-map-panel" class="service-map-card" role="tabpanel" aria-label="Mapa de cobertura regional">
          <div class="service-map-card__frame">
            <iframe
              id="service-map-frame"
              src={initialMapSrc}
              title="Mapa de cobertura em São José, Florianópolis, Palhoça e Biguaçu - SC"
              width="100%"
              height="450"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Features / Quality Pillars -->
        <div class="service-areas__features">
          {serviceAreas.features.map((feat) => (
            <div class="feature-card">
              <div class="feature-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="feature-card__title">{feat.title}</h4>
                <p class="feature-card__text">{feat.text}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Direct CTA Bar -->
        <div class="service-areas__cta-box">
          <div class="service-areas__cta-text">
            <strong>Precisa de pintura em São José, Florianópolis, Palhoça ou Biguaçu?</strong>
            <span>Agende uma visita técnica ou tire dúvidas diretamente no WhatsApp.</span>
          </div>
          <div class="service-areas__cta-actions">
            <a href="#contato" class="btn btn--primary">
              Solicitar orçamento
            </a>
            <a href={whatsappConsultUrl} class="btn btn--secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Consultar no WhatsApp</span>
            </a>
            <a
              id="service-map-link"
              href={initialMapDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--secondary"
              title="Abrir localização no Google Maps"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>{serviceAreas.openInMaps}</span>
            </a>
          </div>
        </div>
      </div>
    ) : (
      <p class="service-areas__empty">{serviceAreas.emptyMessage}</p>
    )}
  </div>
</section>

<script>
  function setupServiceMap() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-map-city]");
    const iframe = document.querySelector<HTMLIFrameElement>("#service-map-frame");
    const linkEl = document.querySelector<HTMLAnchorElement>("#service-map-link");

    if (!buttons.length || !iframe) return;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const query = btn.dataset.query;
        const zoom = btn.dataset.zoom || "13";

        buttons.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("is-active");
        btn.setAttribute("aria-selected", "true");

        if (query) {
          iframe.src = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&t=&z=${zoom}&ie=UTF8&iwloc=&output=embed`;
          if (linkEl) {
            linkEl.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
          }
        }
      });
    });
  }

  // Setup on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupServiceMap);
  } else {
    setupServiceMap();
  }
</script>

<style>
  .service-areas {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .service-areas__header {
    text-align: center;
    max-width: var(--content-max);
    margin: 0 auto var(--space-4);
  }

  .service-areas__badge {
    margin-bottom: var(--space-2);
    display: inline-flex;
  }

  .service-areas__header h2 {
    font-size: var(--size-h2);
    color: var(--color-ink);
    margin: 0 0 var(--space-2);
  }

  .service-areas__intro {
    font-size: var(--size-body);
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .service-areas__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Interactive City Switcher Tabs */
  .service-areas__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    justify-content: center;
    margin-bottom: var(--space-1);
  }

  .city-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.1rem;
    font-size: var(--size-small);
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-ink);
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all var(--motion-instant) ease;
  }

  .city-tab:hover {
    border-color: var(--color-accent);
    background-color: rgba(62, 79, 60, 0.05);
    color: var(--color-accent);
  }

  .city-tab.is-active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
    box-shadow: var(--shadow-warm-soft);
  }

  .city-tab__icon {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .city-tab.is-active .city-tab__icon {
    opacity: 1;
    stroke: #ffffff;
  }

  /* Map Card Container */
  .service-map-card {
    background-color: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    overflow: hidden;
    box-shadow: var(--shadow-warm);
  }

  /* Responsive Map Frame */
  .service-map-card__frame {
    position: relative;
    width: 100%;
    background-color: #ede9e0;
    line-height: 0;
  }

  .service-map-card__frame iframe {
    width: 100%;
    height: 450px;
    display: block;
  }

  /* Feature cards */
  .service-areas__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  @media (min-width: 680px) {
    .service-areas__features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: var(--space-2) var(--space-3);
    box-shadow: var(--shadow-warm-soft);
  }

  .feature-card__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgba(62, 79, 60, 0.08);
    color: var(--color-accent);
  }

  .feature-card__title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
  }

  .feature-card__text {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* CTA Bar */
  .service-areas__cta-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    padding: var(--space-3) var(--space-4);
    box-shadow: var(--shadow-warm-soft);
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .service-areas__cta-box {
      flex-direction: row;
    }
  }

  .service-areas__cta-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .service-areas__cta-text {
      text-align: left;
    }
  }

  .service-areas__cta-text strong {
    font-size: 1rem;
    color: var(--color-ink);
  }

  .service-areas__cta-text span {
    font-size: var(--size-small);
    color: var(--color-muted);
  }

  .service-areas__cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .service-areas__empty {
    text-align: center;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .service-map-card__frame iframe {
      height: 340px;
    }

    .service-areas__cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .service-areas__cta-actions .btn {
      width: 100%;
    }
  }
</style>
