---
// src/components/HouseFacadeSvg.astro
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["house-facade-wrap", className]} data-house-facade>
  <svg
    viewBox="0 0 800 520"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="house-facade-svg"
    role="img"
    aria-label="Ilustração da fachada residencial para simulação de cores"
  >
    <defs>
      <!-- Ambient and architectural shadows -->
      <filter id="facade-shadow" x="-5%" y="0%" width="110%" height="120%" filterUnits="userSpaceOnUse">
        <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#2a2420" flood-opacity="0.12" />
      </filter>
      <filter id="portico-shadow" x="-10%" y="0%" width="120%" height="130%">
        <feDropShadow dx="4" dy="10" stdDeviation="8" flood-color="#2a2420" flood-opacity="0.16" />
      </filter>

      <!-- Window Glass Gradient -->
      <linearGradient id="glass-glare" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#cfdce6" stop-opacity="0.85" />
        <stop offset="45%" stop-color="#b6cbd8" stop-opacity="0.75" />
        <stop offset="50%" stop-color="#ffffff" stop-opacity="0.9" />
        <stop offset="55%" stop-color="#a4bdcc" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#8ba5b5" stop-opacity="0.85" />
      </linearGradient>

      <!-- Soft Sky Backdrop -->
      <linearGradient id="sky-soft" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#eef2f5" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#ede9e0" stop-opacity="0.1" />
      </linearGradient>
    </defs>

    <!-- Sky / Ambient background -->
    <rect x="0" y="0" width="800" height="420" fill="url(#sky-soft)" />

    <!-- Distant Neutral Foliage / Tree Silhouette -->
    <g opacity="0.35">
      <circle cx="80" cy="220" r="60" fill="#7a8b75" />
      <circle cx="120" cy="190" r="50" fill="#657660" />
      <circle cx="730" cy="240" r="65" fill="#7a8b75" />
      <circle cx="690" cy="210" r="55" fill="#657660" />
    </g>

    <!-- Base / Ground / Sidewalk -->
    <rect x="0" y="420" width="800" height="100" fill="#ded7cb" />
    <line x1="0" y1="420" x2="800" y2="420" stroke="#c7bea8" stroke-width="2" />
    <!-- Driveway Pavers Lines -->
    <path d="M120 420 L90 520 M200 420 L180 520 M310 420 L300 520" stroke="#cfc7b4" stroke-width="1.5" stroke-dasharray="6 4" />

    <!-- HOUSE MAIN BODY (FILTER SHADOW) -->
    <g filter="url(#facade-shadow)">

      <!-- 7. TELHADO / PLATIBANDA (ROOF) -->
      <g class="facade-part" data-part="roof">
        <!-- Sloped or modern flat roof parapet cap -->
        <path
          d="M 120 120 L 460 70 L 460 100 L 120 145 Z"
          class="part-roof-sloped"
          fill="var(--house-roof, #544E48)"
        />
        <!-- Right volume roof parapet -->
        <rect
          x="440"
          y="110"
          width="250"
          height="18"
          rx="2"
          class="part-roof-parapet"
          fill="var(--house-roof, #544E48)"
        />
      </g>

      <!-- 1. PAREDES PRINCIPAIS (WALL) -->
      <g class="facade-part" data-part="wall">
        <!-- Main Left Volume (2-story block) -->
        <rect
          x="130"
          y="140"
          width="320"
          height="280"
          class="part-wall-main"
          fill="var(--house-wall, #ECE8E1)"
        />

        <!-- Right Volume (Garage & Upper Suite block) -->
        <rect
          x="450"
          y="125"
          width="230"
          height="295"
          class="part-wall-right"
          fill="var(--house-wall, #ECE8E1)"
        />
      </g>

      <!-- Ambient Shadow under Roof Overhang -->
      <rect x="130" y="140" width="320" height="12" fill="#2a2420" opacity="0.1" />
      <rect x="440" y="125" width="240" height="10" fill="#2a2420" opacity="0.08" />

      <!-- 2. DETALHES E MOLDURAS (DETAILS) -->
      <g class="facade-part" data-part="details">
        <!-- Entrance Portico Frame -->
        <path
          d="M 320 220 L 460 220 L 460 420 L 430 420 L 430 250 L 320 250 Z"
          fill="var(--house-details, #DFD5C6)"
          filter="url(#portico-shadow)"
        />
        <!-- Upper Balcony / Architectural Fascia Beam -->
        <rect
          x="150"
          y="230"
          width="170"
          height="14"
          rx="2"
          fill="var(--house-details, #DFD5C6)"
        />
        <!-- Architectural Vertical Trim Panel beside right suite window -->
        <rect
          x="630"
          y="150"
          width="36"
          height="120"
          rx="2"
          fill="var(--house-details, #DFD5C6)"
        />
        <!-- Horizontal Sill Details -->
        <rect x="160" y="215" width="150" height="8" rx="1" fill="var(--house-details, #DFD5C6)" />
        <rect x="480" y="270" width="140" height="8" rx="1" fill="var(--house-details, #DFD5C6)" />
      </g>

      <!-- 3. ESQUADRIAS / JANELAS (WINDOWS) -->
      <g class="facade-part" data-part="windows">
        <!-- Upper Left Window -->
        <rect x="170" y="160" width="130" height="60" rx="3" fill="var(--house-windows, #36393E)" />
        <!-- Window Glass -->
        <rect x="175" y="165" width="58" height="50" fill="url(#glass-glare)" />
        <rect x="237" y="165" width="58" height="50" fill="url(#glass-glare)" />

        <!-- Ground Floor Living Room Window -->
        <rect x="160" y="280" width="140" height="110" rx="3" fill="var(--house-windows, #36393E)" />
        <!-- Window Glass Grid -->
        <rect x="166" y="286" width="61" height="98" fill="url(#glass-glare)" />
        <rect x="233" y="286" width="61" height="98" fill="url(#glass-glare)" />

        <!-- Upper Right Bedroom Window -->
        <rect x="490" y="155" width="120" height="75" rx="3" fill="var(--house-windows, #36393E)" />
        <rect x="496" y="161" width="51" height="63" fill="url(#glass-glare)" />
        <rect x="553" y="161" width="51" height="63" fill="url(#glass-glare)" />
      </g>

      <!-- 4. PORTA DE ENTRADA (DOOR) -->
      <g class="facade-part" data-part="door">
        <!-- Door Frame -->
        <rect x="345" y="250" width="80" height="170" fill="#2a2420" opacity="0.3" />
        <!-- Main Door Leaf -->
        <rect
          x="348"
          y="253"
          width="74"
          height="167"
          rx="2"
          class="part-door-leaf"
          fill="var(--house-door, #6E4A35)"
        />
        <!-- Modern Long Vertical Handle -->
        <rect x="356" y="320" width="4" height="45" rx="2" fill="#E8EDF2" stroke="#6D757D" stroke-width="0.5" />
        <!-- Modern subtle wood/horizontal relief lines -->
        <line x1="348" y1="285" x2="422" y2="285" stroke="#2a2420" stroke-opacity="0.15" stroke-width="1.5" />
        <line x1="348" y1="320" x2="422" y2="320" stroke="#2a2420" stroke-opacity="0.15" stroke-width="1.5" />
        <line x1="348" y1="355" x2="422" y2="355" stroke="#2a2420" stroke-opacity="0.15" stroke-width="1.5" />
        <line x1="348" y1="390" x2="422" y2="390" stroke="#2a2420" stroke-opacity="0.15" stroke-width="1.5" />
        <!-- Entrance Step -->
        <rect x="335" y="416" width="100" height="6" rx="1" fill="#c4bcad" />
      </g>

      <!-- 5. PORTÃO DA GARAGEM (GARAGE) -->
      <g class="facade-part" data-part="garage">
        <!-- Garage Portal Frame -->
        <rect x="475" y="275" width="190" height="145" rx="2" fill="#2a2420" opacity="0.2" />
        <!-- Garage Door Surface -->
        <rect
          x="480"
          y="278"
          width="180"
          height="142"
          rx="2"
          class="part-garage-door"
          fill="var(--house-garage, #4A4D52)"
        />
        <!-- Horizontal Slats Texture -->
        <line x1="480" y1="302" x2="660" y2="302" stroke="#2a2420" stroke-opacity="0.2" stroke-width="2" />
        <line x1="480" y1="326" x2="660" y2="326" stroke="#2a2420" stroke-opacity="0.2" stroke-width="2" />
        <line x1="480" y1="350" x2="660" y2="350" stroke="#2a2420" stroke-opacity="0.2" stroke-width="2" />
        <line x1="480" y1="374" x2="660" y2="374" stroke="#2a2420" stroke-opacity="0.2" stroke-width="2" />
        <line x1="480" y1="398" x2="660" y2="398" stroke="#2a2420" stroke-opacity="0.2" stroke-width="2" />
      </g>

      <!-- 6. MURO E MURETAS (FENCE) -->
      <g class="facade-part" data-part="fence">
        <!-- Left front garden low wall -->
        <rect
          x="50"
          y="370"
          width="90"
          height="50"
          rx="2"
          class="part-fence-left"
          fill="var(--house-fence, #D8CEBE)"
        />
        <rect x="46" y="367" width="98" height="6" rx="1" fill="var(--house-details, #DFD5C6)" />

        <!-- Right perimeter boundary wall -->
        <rect
          x="670"
          y="340"
          width="80"
          height="80"
          rx="2"
          class="part-fence-right"
          fill="var(--house-fence, #D8CEBE)"
        />
        <rect x="666" y="337" width="88" height="6" rx="1" fill="var(--house-details, #DFD5C6)" />
      </g>
    </g>

    <!-- Foreground Natural Landscaping (Warm & realistic residential feel) -->
    <g>
      <!-- Modern Square Planter Box near Entrance -->
      <rect x="315" y="390" width="24" height="30" rx="1" fill="#756f64" />
      <!-- Sansevieria / Ornamental Plant in pot -->
      <path d="M320 390 Q317 350 322 340 Q326 360 323 390 Z" fill="#446141" />
      <path d="M326 390 Q328 345 330 335 Q333 360 329 390 Z" fill="#587c53" />
      <path d="M331 390 Q336 355 334 345 Q332 365 333 390 Z" fill="#3b5239" />

      <!-- Left Flowerbed shrub -->
      <path d="M 60 420 C 50 395 70 380 90 385 C 105 375 125 385 130 405 C 135 415 130 420 120 420 Z" fill="#4f634b" />
      <path d="M 80 420 C 75 405 90 395 105 400 C 115 390 130 400 135 420 Z" fill="#698264" opacity="0.8" />
    </g>
  </svg>

  <!-- Interactive Highlight Indicator Overlay (pulse ring around active selection) -->
  <div class="house-indicator-badge" data-house-indicator>
    <span class="house-indicator-dot"></span>
    <span class="house-indicator-text" data-house-indicator-text>Área ativa: Paredes</span>
  </div>
</div>

<style>
  .house-facade-wrap {
    width: 100%;
    position: relative;
    border-radius: var(--radius-frame);
    overflow: hidden;
    background: #fbf9f5;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-warm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .house-facade-svg {
    width: 100%;
    height: auto;
    display: block;
    max-height: 480px;
    object-fit: contain;
  }

  /* Smooth color transitions on all paintable SVG elements */
  .facade-part path,
  .facade-part rect {
    transition: fill var(--motion-quick) var(--ease-reveal),
                stroke var(--motion-quick) var(--ease-reveal),
                filter var(--motion-quick) var(--ease-reveal);
  }

  /* When an area is active / selected in the UI */
  .facade-part--active path,
  .facade-part--active rect {
    filter: drop-shadow(0 0 6px rgba(199, 154, 73, 0.65));
  }

  .house-indicator-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: rgba(251, 249, 245, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink);
    box-shadow: 0 2px 8px rgba(42, 36, 32, 0.08);
    pointer-events: none;
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .house-indicator-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent-ochre);
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(199, 154, 73, 0.3);
    animation: qw-pulse 2s infinite;
  }

  @keyframes qw-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(199, 154, 73, 0.6); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(199, 154, 73, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(199, 154, 73, 0); }
  }
</style>
