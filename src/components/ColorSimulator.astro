---
// src/components/ColorSimulator.astro
import HouseFacadeSvg from "./HouseFacadeSvg.astro";
import Icon from "./Icon.astro";
import { colorSimulator } from "../content/copy";
import {
  facadeAreas,
  colorGroups,
  colorSwatches,
  presetCombinations,
} from "../data/colors";
import { whatsappHref } from "../utils/whatsapp";

const contactWhatsAppHref = whatsappHref("Olá, Reginaldo! Gostaria de conversar sobre ideias de cores para a minha casa.");
---

<section id="ideias-de-cores" class="section section--surface color-sim-section">
  <div class="container">
    <!-- Section Header -->
    <div class="color-sim__header">
      <span class="chip color-sim__badge">
        <span class="chip__swatch chip__swatch--ochre"></span>
        <span>{colorSimulator.badge}</span>
      </span>
      <h2>{colorSimulator.heading}</h2>
      <p class="color-sim__intro">{colorSimulator.intro}</p>
    </div>

    <!-- Main Simulator 3-Column Grid -->
    <div class="color-sim__layout" data-color-sim>
      
      <!-- LEFT COLUMN: Area Selector & Color Swatches -->
      <div class="color-sim__col color-sim__controls">
        <div class="sim-box">
          <h3 class="sim-box__title">
            <Icon name="brush" size={20} class="sim-box__icon" />
            <span>{colorSimulator.areaSelectorHeading}</span>
          </h3>

          <!-- Area Selector Tabs -->
          <div class="sim-areas" role="group" aria-label="Partes da casa">
            {facadeAreas.map((area, idx) => (
              <button
                type="button"
                class:list={["sim-area-btn", { "sim-area-btn--active": idx === 0 }]}
                data-sim-area={area.id}
                aria-pressed={idx === 0 ? "true" : "false"}
              >
                <span class="sim-area-btn__swatch" data-sim-area-swatch={area.id} style={`background-color: ${area.defaultColor};`}></span>
                <span class="sim-area-btn__label">{area.label}</span>
              </button>
            ))}
          </div>

          <div class="sim-divider"></div>

          <!-- Color Swatches Library -->
          <h3 class="sim-box__title">
            <Icon name="drop" size={20} class="sim-box__icon" />
            <span>{colorSimulator.paletteHeading}</span>
          </h3>

          <!-- Color Group Filter Pills -->
          <div class="sim-groups" role="tablist" aria-label="Categorias de cores">
            <button type="button" class="sim-group-pill sim-group-pill--active" data-group-filter="all">Todas</button>
            {colorGroups.map((group) => (
              <button type="button" class="sim-group-pill" data-group-filter={group.id}>
                {group.label}
              </button>
            ))}
          </div>

          <!-- Swatches Grid -->
          <div class="sim-swatches" role="group" aria-label="Paleta de cores">
            {colorSwatches.map((swatch) => (
              <button
                type="button"
                class="sim-swatch"
                data-sim-swatch
                data-hex={swatch.hex}
                data-name={swatch.name}
                data-group={swatch.group}
                title={`${swatch.name} (${swatch.hex})`}
                aria-label={`${swatch.name} (${swatch.hex})`}
              >
                <span class="sim-swatch__circle" style={`background-color: ${swatch.hex};`}></span>
                <span class="sim-swatch__name">{swatch.name}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- CENTER COLUMN: Visual House Simulator Preview -->
      <div class="color-sim__col color-sim__preview">
        <div class="sim-preview-wrap">
          <HouseFacadeSvg class="sim-house-svg" />

          <!-- Simulator Top Toolbar -->
          <div class="sim-toolbar">
            <button type="button" class="btn btn--secondary sim-toolbar__btn" data-sim-reset>
              <Icon name="arrows" size={16} />
              <span>{colorSimulator.resetLabel}</span>
            </button>

            <button type="button" class="btn btn--primary sim-toolbar__btn" data-sim-save>
              <Icon name="check" size={16} />
              <span>{colorSimulator.likedCombinationLabel}</span>
            </button>
          </div>
        </div>

        <!-- Color Disclaimer Note -->
        <p class="sim-disclaimer">
          {colorSimulator.disclaimer}
        </p>

        <!-- Summary Expansion Card (Shows when 'Gostei dessa combinação' is clicked) -->
        <div class="sim-summary-card" data-sim-summary-card hidden>
          <div class="sim-summary-card__head">
            <h4>{colorSimulator.summaryTitle}</h4>
            <button type="button" class="sim-summary-close" data-sim-summary-close aria-label="Fechar resumo">×</button>
          </div>
          <div class="sim-summary-list" data-sim-summary-items>
            <!-- Injected via JavaScript -->
          </div>
          <div class="sim-summary-actions">
            <a href="#contato" class="btn btn--primary sim-summary-cta" data-sim-quote-cta>
              <Icon name="clipboard" size={18} />
              <span>{colorSimulator.quoteWithColorsLabel}</span>
            </a>
            <button type="button" class="btn btn--secondary sim-summary-wa" data-sim-whatsapp-cta>
              <Icon name="whatsapp" size={18} />
              <span>Enviar essa combinação no WhatsApp</span>
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Presets & Smart Recommendations -->
      <div class="color-sim__col color-sim__presets">
        <div class="sim-box">
          <h3 class="sim-box__title">
            <Icon name="tape" size={20} class="sim-box__icon" />
            <span>{colorSimulator.presetsHeading}</span>
          </h3>
          <p class="sim-box__subtitle">Paletas harmoniosas prontas para aplicar em um clique:</p>

          <div class="sim-preset-list">
            {presetCombinations.map((preset) => (
              <div class="sim-preset-card">
                <div class="sim-preset-card__top">
                  <div>
                    <h4 class="sim-preset-card__title">{preset.name}</h4>
                    {preset.styleTag && <span class="sim-preset-card__tag">{preset.styleTag}</span>}
                  </div>
                  <!-- 4-Color Swatch Preview Bar -->
                  <div class="sim-preset-preview">
                    {preset.previewColors.map((color) => (
                      <span class="sim-preset-preview__dot" style={`background-color: ${color};`}></span>
                    ))}
                  </div>
                </div>
                <p class="sim-preset-card__desc">{preset.description}</p>
                <button
                  type="button"
                  class="btn btn--secondary sim-preset-btn"
                  data-sim-apply-preset={preset.id}
                >
                  {colorSimulator.applyPresetLabel}
                </button>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Conversion Card -->
    <div class="color-sim__cta-box">
      <div class="color-sim__cta-content">
        <h3>{colorSimulator.conversionHeading}</h3>
        <p>Peça um orçamento com as cores que você escolheu ou tire dúvidas técnicas sobre acabamentos com o Reginaldo.</p>
      </div>
      <div class="color-sim__cta-actions">
        <a href="#contato" class="btn btn--primary">
          <Icon name="clipboard" size={20} />
          <span>{colorSimulator.primaryCtaLabel}</span>
        </a>
        <a href={contactWhatsAppHref} target="_blank" rel="noopener noreferrer" class="btn btn--secondary">
          <Icon name="whatsapp" size={20} />
          <span>{colorSimulator.secondaryCtaLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    defaultFacadePalette,
    facadeAreas,
    presetCombinations,
  } from "../data/colors";
  import {
    buildColorSummary,
    buildColorQuoteWhatsappMessage,
  } from "../utils/colorSimulator";
  import { whatsappHref } from "../utils/whatsapp";
  import type { FacadeAreaId, FacadePalette } from "../types/colors";

  const root = document.querySelector<HTMLElement>("[data-color-sim]");
  if (root) {
    const simRoot = root;
    let currentArea: FacadeAreaId = "wall";
    const currentPalette: FacadePalette = { ...defaultFacadePalette };

    // Elements
    const houseWrap = root.querySelector<HTMLElement>("[data-house-facade]");
    const indicatorText = root.querySelector<HTMLElement>("[data-house-indicator-text]");
    const areaButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sim-area]"));
    const swatchButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sim-swatch]"));
    const groupPills = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-group-filter]"));
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-sim-reset]");
    const saveBtn = root.querySelector<HTMLButtonElement>("[data-sim-save]");
    const presetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sim-apply-preset]"));

    // Summary Card Elements
    const summaryCard = root.querySelector<HTMLElement>("[data-sim-summary-card]");
    const summaryClose = root.querySelector<HTMLButtonElement>("[data-sim-summary-close]");
    const summaryItemsContainer = root.querySelector<HTMLElement>("[data-sim-summary-items]");
    const whatsappCta = root.querySelector<HTMLButtonElement>("[data-sim-whatsapp-cta]");

    // Function to apply colors to the SVG via CSS custom properties
    function renderPalette() {
      if (!houseWrap) return;
      houseWrap.style.setProperty("--house-wall", currentPalette.wall);
      houseWrap.style.setProperty("--house-details", currentPalette.details);
      houseWrap.style.setProperty("--house-windows", currentPalette.windows);
      houseWrap.style.setProperty("--house-door", currentPalette.door);
      houseWrap.style.setProperty("--house-garage", currentPalette.garage);
      houseWrap.style.setProperty("--house-fence", currentPalette.fence);
      houseWrap.style.setProperty("--house-roof", currentPalette.roof);

      // Update color swatches in the area buttons
      facadeAreas.forEach((area) => {
        const swatchEl = simRoot.querySelector<HTMLElement>(`[data-sim-area-swatch="${area.id}"]`);
        if (swatchEl) {
          swatchEl.style.backgroundColor = currentPalette[area.id];
        }
      });

      // Update active area highlight in SVG
      simRoot.querySelectorAll<SVGElement>(".facade-part").forEach((part) => {
        const partName = part.getAttribute("data-part");
        part.classList.toggle("facade-part--active", partName === currentArea);
      });
    }

    function setActiveArea(areaId: FacadeAreaId) {
      currentArea = areaId;
      areaButtons.forEach((btn) => {
        const isActive = btn.getAttribute("data-sim-area") === areaId;
        btn.classList.toggle("sim-area-btn--active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });

      const areaObj = facadeAreas.find((a) => a.id === areaId);
      if (indicatorText && areaObj) {
        indicatorText.textContent = `Área ativa: ${areaObj.label}`;
      }

      renderPalette();
    }

    // Area button clicks
    areaButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const areaId = btn.getAttribute("data-sim-area") as FacadeAreaId;
        if (areaId) setActiveArea(areaId);
      });
    });

    // Swatch clicks: applies chosen color to currentArea
    swatchButtons.forEach((swatch) => {
      swatch.addEventListener("click", () => {
        const hex = swatch.getAttribute("data-hex");
        if (!hex) return;
        currentPalette[currentArea] = hex;
        renderPalette();

        // Highlight selected swatch
        swatchButtons.forEach((s) => s.classList.remove("sim-swatch--active"));
        swatch.classList.add("sim-swatch--active");
      });
    });

    // Color group filter pills
    groupPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const group = pill.getAttribute("data-group-filter");
        groupPills.forEach((p) => p.classList.toggle("sim-group-pill--active", p === pill));

        swatchButtons.forEach((swatch) => {
          const swatchGroup = swatch.getAttribute("data-group");
          if (group === "all" || swatchGroup === group) {
            swatch.hidden = false;
          } else {
            swatch.hidden = true;
          }
        });
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        Object.assign(currentPalette, defaultFacadePalette);
        renderPalette();
        swatchButtons.forEach((s) => s.classList.remove("sim-swatch--active"));
      });
    }

    // Presets click
    presetButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const presetId = btn.getAttribute("data-sim-apply-preset");
        const found = presetCombinations.find((p) => p.id === presetId);
        if (found) {
          Object.assign(currentPalette, found.colors);
          renderPalette();

          // Pulse animation on the house to show combination was applied
          houseWrap?.animate(
            [
              { opacity: 0.88, transform: "scale(0.995)" },
              { opacity: 1, transform: "scale(1)" },
            ],
            { duration: 250, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          );
        }
      });
    });

    // Save & View Summary Card
    function renderSummary() {
      if (!summaryItemsContainer) return;
      const items = buildColorSummary(currentPalette);
      summaryItemsContainer.innerHTML = items
        .map(
          (item) => `
        <div class="sim-summary-item">
          <span class="sim-summary-item__swatch" style="background-color: ${item.hex};"></span>
          <span class="sim-summary-item__label">${item.areaLabel}:</span>
          <strong class="sim-summary-item__name">${item.colorName}</strong>
        </div>
      `
        )
        .join("");
    }

    if (saveBtn) {
      saveBtn.addEventListener("click", () => {
        if (summaryCard) {
          renderSummary();
          summaryCard.hidden = false;
          summaryCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    }

    if (summaryClose) {
      summaryClose.addEventListener("click", () => {
        if (summaryCard) summaryCard.hidden = true;
      });
    }

    if (whatsappCta) {
      whatsappCta.addEventListener("click", () => {
        const msg = buildColorQuoteWhatsappMessage(currentPalette);
        const href = whatsappHref(msg);
        if (href.startsWith("https://wa.me/")) {
          window.open(href, "_blank", "noopener,noreferrer");
        } else {
          alert("Sua combinação foi registrada! Como o número do WhatsApp está sendo ativado, você pode apresentar esta combinação durante a visita técnica.");
        }
      });
    }

    // Initial render
    setActiveArea("wall");
    renderPalette();
  }
</script>

<style>
  .color-sim-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    position: relative;
  }

  .color-sim__header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .color-sim__badge {
    margin-bottom: var(--space-2);
  }

  .color-sim__header h2 {
    font-size: var(--size-h2);
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .color-sim__intro {
    font-size: var(--size-body);
    color: var(--color-muted);
    margin-inline: auto;
  }

  /* 3-Column Layout */
  .color-sim__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 900px) {
    .color-sim__layout {
      grid-template-columns: 280px 1fr 290px;
      gap: var(--space-3);
    }
  }

  @media (min-width: 1100px) {
    .color-sim__layout {
      grid-template-columns: 310px 1fr 310px;
      gap: var(--space-4);
    }
  }

  /* Shared Container Box */
  .sim-box {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-frame);
    padding: var(--space-3);
    box-shadow: var(--shadow-warm-soft);
  }

  .sim-box__title {
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sim-box__icon {
    color: var(--color-accent);
  }

  .sim-box__subtitle {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  .sim-divider {
    height: 1px;
    background: var(--color-line);
    margin: var(--space-4) 0;
  }

  /* Area Selector Buttons */
  .sim-areas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 640px) and (max-width: 899px) {
    .sim-areas {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sim-area-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.65rem;
    background: var(--color-canvas);
    border: 1.5px solid transparent;
    border-radius: var(--radius-control);
    font-size: 0.85rem;
    color: var(--color-ink);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .sim-area-btn:hover {
    border-color: var(--color-muted);
    background: #ffffff;
  }

  .sim-area-btn--active {
    background: #ffffff;
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 2px 6px rgba(62, 79, 60, 0.12);
  }

  .sim-area-btn__swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  /* Group Filter Pills */
  .sim-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-3);
  }

  .sim-group-pill {
    background: rgba(42, 36, 32, 0.05);
    border: none;
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .sim-group-pill:hover {
    background: rgba(42, 36, 32, 0.1);
    color: var(--color-ink);
  }

  .sim-group-pill--active {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  /* Swatches Grid */
  .sim-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.5rem;
    max-height: 260px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .sim-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.35rem;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    cursor: pointer;
    text-align: center;
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .sim-swatch:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .sim-swatch--active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .sim-swatch__circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }

  .sim-swatch__name {
    font-size: 0.75rem;
    color: var(--color-ink);
    line-height: 1.1;
  }

  /* Center Preview & Toolbar */
  .sim-preview-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sim-toolbar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .sim-toolbar__btn {
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
    gap: 0.4rem;
  }

  .sim-disclaimer {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-align: center;
    margin: var(--space-2) auto 0;
    max-width: 36rem;
  }

  /* Summary Card */
  .sim-summary-card {
    background: #ffffff;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-control);
    padding: var(--space-4);
    margin-top: var(--space-3);
    box-shadow: var(--shadow-warm);
    animation: qw-fade-in 200ms ease;
  }

  .sim-summary-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  .sim-summary-card__head h4 {
    margin: 0;
    font-size: 1.05rem;
    font-family: var(--font-body);
    font-weight: 600;
  }

  .sim-summary-close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-muted);
  }

  :global(.sim-summary-list) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.65rem;
    margin-bottom: var(--space-4);
  }

  :global(.sim-summary-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    background: var(--color-surface);
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-line);
  }

  :global(.sim-summary-item__swatch) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  :global(.sim-summary-item__label) {
    color: var(--color-muted);
  }

  :global(.sim-summary-item__name) {
    color: var(--color-ink);
  }

  .sim-summary-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .sim-summary-actions {
      flex-direction: row;
    }
  }

  .sim-summary-cta,
  .sim-summary-wa {
    flex: 1;
    justify-content: center;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
  }

  /* Presets Column */
  .sim-preset-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-height: 520px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .sim-preset-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: var(--space-3);
    transition: all var(--motion-instant) var(--ease-reveal);
  }

  .sim-preset-card:hover {
    border-color: var(--color-accent);
    background: #ffffff;
  }

  .sim-preset-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .sim-preset-card__title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-ink);
  }

  .sim-preset-card__tag {
    font-size: 0.75rem;
    color: var(--color-accent);
    font-weight: 500;
