---
import "../styles/global.css";
import { businessConfig } from "../config/business";
import { buildLocalBusinessJsonLd } from "../utils/structuredData";

interface Props {
  title?: string;
  description?: string;
  /**
   * Absolute or root-relative path to a 1200×630 share image. Omitted by
   * default — a missing og:image is a quieter failure than a fabricated
   * or generic-looking one on every social share. Pass a real photo once
   * one exists (e.g. a portfolio hero shot).
   */
  ogImage?: string;
}

const { businessName, city } = businessConfig;

// Title/description are templates that upgrade the moment `city` is
// confirmed, rather than needing a code change — see docs §20.
const defaultTitle = city
  ? `${businessName} | Pintor Residencial em ${city}`
  : businessName;

const defaultDescription = city
  ? `Pintura residencial interna e externa em ${city}. Orçamento gratuito.`
  : "Pintura residencial interna e externa, com atenção a cada detalhe. Orçamento gratuito.";

const { title = defaultTitle, description = defaultDescription, ogImage } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const jsonLd = buildLocalBusinessJsonLd(siteUrl || Astro.url.origin);
const absoluteOgImage = ogImage
  ? new URL(ogImage, Astro.url.origin).toString()
  : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    <!-- Fraunces (display) + General Sans (body) — see docs §10 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..72,400;9..72,500;9..72,600&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
